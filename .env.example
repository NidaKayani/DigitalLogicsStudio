REACT_APP_API_URL=https://digital-logics-studio-backend-three.vercel.app/api
REACT_APP_SITE_URL=https://circuits.quantumlogicslimited.com

# Optional: override the BoolMentor chat endpoint (defaults to REACT_APP_API_URL/ai).
# Circuit generate/hint always use REACT_APP_API_URL/ai — do not point this at the chatbot
# if you expect AI Generate to work through that URL.
# Do not put inline comments on the same line as a URL value — it breaks the URL.
# REACT_APP_AI_URL=https://your-ai-backend.vercel.app/api/ai

# QuantumChat dock (sign-in / keys / chats) — API + full-app link
# REACT_APP_QUANTUMCHAT_URL=https://chat.quantumlogicslimited.com/chat
# REACT_APP_QUANTUMCHAT_API_URL=https://quantum-chat-backend-six.vercel.app
# Local QuantumChat backend (use a free port — DLS backend often uses 5000):
# REACT_APP_QUANTUMCHAT_API_URL=http://localhost:5050
